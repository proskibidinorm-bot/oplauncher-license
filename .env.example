# Database: use SQLite for local/dev or free hosting without Postgres.
# DATABASE_URL=sqlite:///./licenses.db
# Or PostgreSQL (Neon, Supabase, Railway, Render free tiers):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

DATABASE_URL=sqlite:///./licenses.db

# Secret used to sign admin session tokens (auto-generated if empty on first run)
ADMIN_JWT_SECRET=

# CORS origins (comma-separated). Add your launcher origin if needed.
CORS_ORIGINS=*

# Host/port
HOST=0.0.0.0
PORT=8000